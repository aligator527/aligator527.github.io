---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import { DEFAULT_LOCALE } from '../../utils/i18n';
import { getWork, workSlug } from '../../utils/work';

/*
 * English routes only, and deliberately unprefixed: `/work/<slug>/` is already indexed. A localised
 * copy of this route gets its own file under the locale's directory rather than a locale parameter
 * here, so these URLs cannot move by accident.
 */
export const getStaticPaths = (async () => {
  const work = await getWork(DEFAULT_LOCALE);
  return work.map((entry, index) => ({
    params: { slug: workSlug(entry) },
    props: { entry, previous: work[index - 1], next: work[index + 1] },
  }));
}) satisfies GetStaticPaths;

const { entry, previous, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<CaseStudyLayout entry={entry} headings={headings} previous={previous} next={next}>
  <Content />
</CaseStudyLayout>
