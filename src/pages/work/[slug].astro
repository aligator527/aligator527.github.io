---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import { getWork } from '../../utils/work';

export const getStaticPaths = (async () => {
  const work = await getWork();
  return work.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, previous: work[index - 1], next: work[index + 1] },
  }));
}) satisfies GetStaticPaths;

const { entry, previous, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<CaseStudyLayout entry={entry} headings={headings} previous={previous} next={next}>
  <Content />
</CaseStudyLayout>
