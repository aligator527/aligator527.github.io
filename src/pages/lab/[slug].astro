---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/core/PageHeader.astro';
import MetaList from '../../components/core/MetaList.astro';
import { localize } from '../../i18n/ui';

/*
 * An entry gets a page of its own only when it has a body. An entry without one is a repository
 * and a demo, and a page repeating its summary would be a worse destination than either.
 */
export const getStaticPaths = (async () => {
  const entries = await getCollection('lab', ({ body }) => Boolean(body?.trim()));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const { t } = localize(Astro.url);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article>
    <PageHeader
      sheet={`Lab / ${entry.data.code}`}
      title={entry.data.title}
      lead={entry.data.summary}
    />
    <div class="page grid">
      <div class="rail">
        <MetaList
          items={[
            { label: t.labStatusLabel, value: t.labStatus[entry.data.status] },
            {
              label: t.labTechnologiesLabel,
              /* A name is one token in a two-column rail: "Web Workers" must not break in half. */
              value: entry.data.technologies
                .map((name) => name.replaceAll(' ', '\u00A0'))
                .join(' · '),
            },
          ]}
        />
        <p class="links">
          {entry.data.repository && <a href={entry.data.repository}>{t.labRepository}</a>}
          {entry.data.demo && <a href={entry.data.demo}>{t.labDemo}</a>}
        </p>
      </div>
      <div class="prose document">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  @layer components {
    /* Same two columns as a note: the body starts where `PageHeader` puts the title and lede, */
    /* and the margin the header leaves empty carries the entry's metadata and its two links. */
    .document {
      grid-column: 1 / -1;
    }

    .rail {
      grid-column: 1 / -1;
      margin-block-end: var(--space-4);
    }

    .links {
      display: flex;
      gap: var(--space-4);
      padding-block-start: var(--space-2);
    }

    @media (min-width: 64rem) {
      .document {
        grid-column: 3 / span 8;
      }

      .rail {
        grid-column: 1 / span 2;
        margin-block-end: 0;
      }

      .links {
        display: grid;
        justify-items: start;
        gap: var(--space-1);
      }
    }
  }
</style>
