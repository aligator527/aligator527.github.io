---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/core/PageHeader.astro';
import { formatMonth } from '../../utils/dates';

const entries = (await getCollection('lab')).sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout
  title="Lab"
  description="Public code, prototypes, and experiments by Ivan Dolgov."
  noindex={entries.length === 0}
>
  <PageHeader
    sheet="Lab / Unpublished"
    title="Lab"
    lead="Public code, prototypes, and experiments."
  />
  <section class="page" aria-labelledby="lab-list">
    <h2 id="lab-list" class="visually-hidden">
      Entries
    </h2>
    {entries.length === 0 ? (
      <p class="empty">No public entries yet.</p>
    ) : (
      <ol class="entries">
        {entries.map((entry) => (
          <li class="entry">
            <p class="meta meta-quiet">
              {formatMonth(entry.data.date.slice(0, 7))} · {entry.data.status}
            </p>
            <h3>{entry.data.title}</h3>
            <p>{entry.data.summary}</p>
            <p class="links">
              {entry.data.repository && <a href={entry.data.repository}>Repository</a>}
              {entry.data.demo && <a href={entry.data.demo}>Demo</a>}
            </p>
          </li>
        ))}
      </ol>
    )}
  </section>
</BaseLayout>

<style>
  @layer components {
    .entries {
      display: grid;
    }

    .entry {
      display: grid;
      gap: var(--space-2);
      padding-block: var(--space-4);
      border-block-start: var(--rule-strong);
      max-inline-size: var(--measure);
    }

    .links {
      display: flex;
      gap: var(--space-4);
    }

    .empty {
      color: var(--text-secondary);
    }
  }
</style>
