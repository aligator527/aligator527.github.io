---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/core/PageHeader.astro';
import { profile } from '../../data/profile';
import { localize } from '../../i18n/ui';
import { formatMonth } from '../../utils/dates';

const { t } = localize(Astro.url);
const entries = (await getCollection('lab')).sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout
  title={t.labTitle}
  description={t.labDescription(profile.name)}
  noindex={entries.length === 0}
>
  <PageHeader sheet={t.labSheet} title={t.labTitle} lead={t.labLead} />
  <section class="page" aria-labelledby="lab-list">
    <h2 id="lab-list" class="visually-hidden">
      {t.labEntriesHeading}
    </h2>
    {entries.length === 0 ? (
      <p class="empty">{t.labEmpty}</p>
    ) : (
      <ol class="entries">
        {entries.map((entry) => (
          <li class="entry">
            <p class="meta meta-quiet">
              {formatMonth(entry.data.date.slice(0, 7))} · {t.labStatus[entry.data.status]}
            </p>
            <h3>{entry.data.title}</h3>
            <p>{entry.data.summary}</p>
            <p class="links">
              {entry.data.repository && <a href={entry.data.repository}>{t.labRepository}</a>}
              {entry.data.demo && <a href={entry.data.demo}>{t.labDemo}</a>}
            </p>
          </li>
        ))}
      </ol>
    )}
  </section>
</BaseLayout>

<style>
  @layer components {
    .entries {
      display: grid;
    }

    .entry {
      display: grid;
      gap: var(--space-2);
      padding-block: var(--space-4);
      border-block-start: var(--rule-strong);
      max-inline-size: var(--measure);
    }

    .links {
      display: flex;
      gap: var(--space-4);
    }

    .empty {
      color: var(--text-secondary);
    }
  }
</style>
