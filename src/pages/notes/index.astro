---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/core/PageHeader.astro';
import { profile } from '../../data/profile';
import { localize } from '../../i18n/ui';
import { localeHref } from '../../utils/i18n';

const { locale, t } = localize(Astro.url);
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) =>
  b.data.publishedAt.localeCompare(a.data.publishedAt),
);
---

<BaseLayout
  title={t.notesTitle}
  description={t.notesDescription(profile.name)}
  noindex={notes.length === 0}
>
  <PageHeader sheet={t.notesSheet} title={t.notesTitle} lead={t.notesLead} />
  <section class="page" aria-labelledby="notes-list">
    <h2 id="notes-list" class="visually-hidden">
      {t.notesArticlesHeading}
    </h2>
    {notes.length === 0 ? (
      <p class="empty">{t.notesEmpty}</p>
    ) : (
      <ol class="entries">
        {notes.map((note) => (
          <li class="entry">
            <p class="meta meta-quiet">
              <time datetime={note.data.publishedAt}>
                {note.data.publishedAt.replaceAll('-', '/')}
              </time>
            </p>
            <h3>
              <a href={localeHref(`/notes/${note.id}/`, locale)}>{note.data.title}</a>
            </h3>
            <p>{note.data.summary}</p>
          </li>
        ))}
      </ol>
    )}
  </section>
</BaseLayout>

<style>
  @layer components {
    .entries {
      display: grid;
    }

    .entry {
      display: grid;
      gap: var(--space-2);
      padding-block: var(--space-4);
      border-block-start: var(--rule-strong);
      max-inline-size: var(--measure);
    }

    .empty {
      color: var(--text-secondary);
    }
  }
</style>
