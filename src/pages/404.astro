---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionLink from '../components/core/ActionLink.astro';
import { localize } from '../i18n/ui';
import { localeHref } from '../utils/i18n';

const { locale, t } = localize(Astro.url);
---

<BaseLayout title={t.notFoundTitle} description={t.notFoundDescription} noindex>
  <section class="page not-found" aria-labelledby="nf-title">
    <div class="grid">
      <p class="meta code">{t.notFoundStatus}</p>
      <h1 id="nf-title">{t.notFoundHeading}</h1>
      <p class="lead">{t.notFoundLead}</p>
      <ol class="routes" role="list" aria-label={t.notFoundRoutes}>
        <li>
          <span class="meta meta-quiet" aria-hidden="true">
            → 01
          </span>
          <ActionLink href={localeHref('/work/', locale)}>{t.navWork}</ActionLink>
        </li>
        <li>
          <span class="meta meta-quiet" aria-hidden="true">
            → 02
          </span>
          <ActionLink href={localeHref('/', locale)}>{t.notFoundHome}</ActionLink>
        </li>
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  @layer components {
    .not-found {
      padding-block: var(--space-8) 0;
    }

    .grid > * {
      grid-column: 1 / -1;
    }

    .code {
      color: var(--signal-text);
      padding-block-end: var(--space-2);
      margin-block-end: var(--space-5);
      border-block-end: var(--rule);
    }

    h1 {
      max-inline-size: var(--measure-title);
    }

    .lead {
      margin-block-start: var(--space-4);
      font-size: var(--text-body-lg);
      color: var(--text-secondary);
    }

    .routes {
      display: grid;
      gap: var(--space-2);
      margin-block-start: var(--space-6);
      padding: 0;
      list-style: none;
    }

    .routes li {
      display: flex;
      gap: var(--space-4);
      align-items: center;
    }

    @media (min-width: 64rem) {
      .grid > h1,
      .grid > .lead,
      .grid > .routes {
        grid-column: 3 / span 8;
      }
    }
  }
</style>
