---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/core/PageHeader.astro';
import MetaList from '../../../components/core/MetaList.astro';
import { localize } from '../../../i18n/ui';
import { EMITTED_LOCALES, localeParam } from '../../../utils/i18n';
import { getLab, hasPage, labSlug } from '../../../utils/writing';

/*
 * An entry gets a page of its own only when it has a body — in every locale, which `getLab()`
 * asserts. An entry without one is a repository and a demo, and a page repeating its summary
 * would be a worse destination than either.
 */
export const getStaticPaths = (async () => {
  const perLocale = await Promise.all(
    EMITTED_LOCALES.map(async (locale) => {
      const entries = await getLab(locale);
      return entries.filter(hasPage).map((entry) => ({
        params: { locale: localeParam(locale), slug: labSlug(entry) },
        props: { entry },
      }));
    }),
  );
  return perLocale.flat();
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { t } = localize(Astro.url);
const sections = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article>
    <PageHeader
      sheet={`${t.labSheetMarker} / ${entry.data.code}`}
      title={entry.data.title}
      lead={entry.data.summary}
    />
    <div class="page grid">
      <div class="rail">
        <MetaList
          items={[
            { label: t.labStatusLabel, value: t.labStatus[entry.data.status] },
            {
              label: t.labTechnologiesLabel,
              /* A name is one token in a two-column rail: "Web Workers" must not break in half. */
              value: entry.data.technologies.map((name) => name.replaceAll(' ', ' ')).join(' · '),
            },
          ]}
        />
        <p class="links">
          {entry.data.repository && <a href={entry.data.repository}>{t.labRepository}</a>}
          {entry.data.demo && <a href={entry.data.demo}>{t.labDemo}</a>}
        </p>
      </div>
      <div class="prose document">
        <Content />
      </div>
      {sections.length > 1 && (
        /* The index to the numbered sections, in the column the header leaves empty. */
        <nav class="contents" aria-label={t.contentsLabel}>
          <p class="meta meta-quiet">{t.contentsHeading}</p>
          <ol>
            {sections.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  @layer components {
    /* Same two columns as a note: the body starts where `PageHeader` puts the title and lede, */
    /* and the margin the header leaves empty carries the entry's metadata and its two links. */
    .document {
      grid-column: 1 / -1;
    }

    .rail {
      grid-column: 1 / -1;
      margin-block-end: var(--space-4);
    }

    .links {
      display: flex;
      gap: var(--space-4);
      padding-block-start: var(--space-2);
    }

    /* Hidden where there is no margin to put it in, as on a case study: on a phone a contents */
    /* list sits between the reader and the first paragraph, and repeats what scrolling gives. */
    .contents {
      display: none;
    }

    .contents ol {
      display: grid;
      gap: var(--space-1);
      margin-block-start: var(--space-2);
      padding: 0;
      list-style: none;
      font-size: var(--text-small);
    }

    @media (min-width: 64rem) {
      .document {
        grid-column: 3 / span 8;
      }

      .contents {
        display: block;
        grid-column: 11 / -1;
        grid-row: 1;
        align-self: start;
        position: sticky;
        inset-block-start: var(--space-4);
      }

      .rail {
        grid-column: 1 / span 2;
        margin-block-end: 0;
      }

      .links {
        display: grid;
        justify-items: start;
        gap: var(--space-1);
      }
    }
  }
</style>
