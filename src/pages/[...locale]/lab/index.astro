---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/core/PageHeader.astro';
import { profile } from '../../../data/profile';
import { localize } from '../../../i18n/ui';
import { localePaths } from '../../../utils/i18n';
import { formatMonth } from '../../../utils/dates';
import MetaList from '../../../components/core/MetaList.astro';
import { getLab, hasPage, labHref } from '../../../utils/writing';

/*
 * One route per locale. English is the `undefined` rest parameter, so this file emits `/lab/` —
 * not `/en/lab/` — and the indexed URL is unchanged. See `localePaths()`.
 */
export const getStaticPaths = localePaths satisfies GetStaticPaths;

const { locale, t } = localize(Astro.url);
const entries = await getLab(locale);
---

<BaseLayout
  title={t.labTitle}
  description={t.labDescription(profile.name)}
  noindex={entries.length === 0}
>
  <PageHeader
    sheet={entries.length === 0 ? t.labSheetEmpty : t.labSheet}
    title={t.labTitle}
    lead={t.labLead}
  />
  <section class="page" aria-labelledby="lab-list">
    <h2 id="lab-list" class="visually-hidden">
      {t.labEntriesHeading}
    </h2>
    {entries.length === 0 ? (
      <p class="empty">{t.labEmpty}</p>
    ) : (
      <ol class="entries">
        {entries.map((entry) => (
          <li class="entry">
            <p class="meta meta-quiet">
              {entry.data.code} · {formatMonth(entry.data.date.slice(0, 7))} ·{' '}
              {t.labStatus[entry.data.status]}
            </p>
            <h3>
              {hasPage(entry) ? (
                <a href={labHref(entry, locale)}>{entry.data.title}</a>
              ) : (
                entry.data.title
              )}
            </h3>
            <p>{entry.data.summary}</p>
            <MetaList
              class="record"
              items={[
                {
                  label: t.labTechnologiesLabel,
                  value: entry.data.technologies
                    .map((name) => name.replaceAll(' ', '\u00A0'))
                    .join(' · '),
                },
              ]}
            />
            <p class="links">
              {entry.data.repository && <a href={entry.data.repository}>{t.labRepository}</a>}
              {entry.data.demo && <a href={entry.data.demo}>{t.labDemo}</a>}
            </p>
          </li>
        ))}
      </ol>
    )}
  </section>
</BaseLayout>

<style>
  @layer components {
    .entries {
      display: grid;
    }

    .entry {
      display: grid;
      gap: var(--space-2);
      padding-block: var(--space-4);
      border-block-start: var(--rule-strong);
      max-inline-size: var(--measure);
    }

    /* Wide enough for two columns, the row becomes a record: what it is on the left, capped at */
    /* the measure, and what it is built with on the right. Below that the stack follows it. */
    @media (min-width: 64rem) {
      .entry {
        grid-template-columns: minmax(0, var(--measure)) minmax(0, 1fr);
        column-gap: var(--space-6);
        max-inline-size: none;
      }

      .entry > :global(.record) {
        grid-column: 2;
        grid-row: 1 / span 4;
        align-self: start;
      }
    }

    .links {
      display: flex;
      gap: var(--space-4);
    }

    .empty {
      color: var(--text-secondary);
    }
  }
</style>
