---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { aboutProse } from '../../components/prose/about';
import PageHeader from '../../components/core/PageHeader.astro';
import StructuredData from '../../components/core/StructuredData.astro';
import SectionHeading from '../../components/core/SectionHeading.astro';
import ActionLink from '../../components/core/ActionLink.astro';
import { localizedProfile } from '../../data/profile';
import { localize } from '../../i18n/ui';
import { localeHref, localePaths } from '../../utils/i18n';
/*
 * One route per locale. English is the `undefined` rest parameter, so this file emits `/about/` —
 * not `/en/about/` — and the indexed URL is unchanged. See `localePaths()`.
 */
export const getStaticPaths = localePaths satisfies GetStaticPaths;

const { locale, t } = localize(Astro.url);
const profile = localizedProfile(t);
const AboutProse = aboutProse[locale];
const proseProps = {
  experience: profile.experience,
  email: profile.email,
  workHref: (slug: string) => localeHref(`/work/${slug}/`, locale),
};
/*
 * The two prose blocks below are still English literals. They are chrome in the sense that they live
 * in a template, but they are narrative with inline links to work pages, so they do not fit a flat
 * dictionary entry; the locale stages give them per-locale page content instead. Everything around
 * them — sheet, title, lead, section headings — already comes from the dictionary.
 */
---

<BaseLayout title={t.aboutTitle} description={t.aboutDescription(profile.name)}>
  <StructuredData slot="head" kind="about" />
  <PageHeader sheet={t.aboutSheet} title={t.aboutTitle} lead={t.aboutLead} />

  <section class="page" aria-labelledby="background-heading">
    <SectionHeading index={1} id="background-heading" title={t.aboutBackgroundTitle} />
    <div class="grid">
      <div class="prose body">
        <AboutProse section="background" {...proseProps} />
      </div>
    </div>
  </section>

  <section class="section page" aria-labelledby="languages-heading">
    <SectionHeading
      index={2}
      id="languages-heading"
      title={t.aboutLanguagesTitle}
      note={t.aboutLanguagesNote}
    />
    <dl class="languages">
      {profile.languages.map((language) => (
        <div class="language">
          <dt>
            <span class="meta signal-text code">{language.code}</span>
            <span class="name">{language.name}</span>
          </dt>
          <dd>{language.level}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section page" aria-labelledby="engage-heading">
    <SectionHeading index={3} id="engage-heading" title={t.aboutEngageTitle} />
    <div class="grid">
      <div class="prose body">
        <p>{profile.availability}</p>
        <AboutProse section="engage" {...proseProps} />
      </div>
      <p class="actions">
        <ActionLink href={localeHref('/work/', locale)}>{t.selectedWork}</ActionLink>
        <ActionLink href={localeHref('/resume/', locale)}>{t.navResume}</ActionLink>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  @layer components {
    .body,
    .actions {
      grid-column: 1 / -1;
    }

    .body {
      font-size: var(--text-body-lg);
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3) var(--space-5);
      margin-block-start: var(--space-5);
    }

    .languages {
      display: grid;
    }

    .language {
      display: grid;
      gap: var(--space-1);
      padding-block: var(--space-4);
      border-block-start: var(--rule-strong);
    }

    .language dt {
      display: flex;
      gap: var(--space-3);
      align-items: baseline;
    }

    .name {
      font-size: var(--text-h3);
      font-weight: 600;
    }

    .code {
      min-inline-size: 2rem;
    }

    .language dd {
      margin: 0;
      color: var(--text-secondary);
    }

    @media (min-width: 64rem) {
      .body,
      .actions {
        grid-column: 3 / span 7;
      }

      .language {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--grid-gutter);
        align-items: baseline;
      }

      .language dt {
        grid-column: 3 / span 4;
      }

      .language dd {
        grid-column: 7 / -1;
      }
    }
  }
</style>
