---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/core/PageHeader.astro';
import SectionHeading from '../../components/core/SectionHeading.astro';
import ActionLink from '../../components/core/ActionLink.astro';
import Timeline from '../../components/experience/Timeline.astro';
import { localizedProfile } from '../../data/profile';
import { localize } from '../../i18n/ui';
import { formatDuration, formatRange } from '../../utils/dates';
import { getRolesWithWork } from '../../utils/experience';
import { localeHref, localePaths } from '../../utils/i18n';
import { depthLabel, engagementLabel, workHref } from '../../utils/work';
/*
 * One route per locale. English is the `undefined` rest parameter, so this file emits
 * `/experience/` — not `/en/experience/` — and the indexed URL is unchanged. See `localePaths()`.
 */
export const getStaticPaths = localePaths satisfies GetStaticPaths;

const { locale, t } = localize(Astro.url);
const profile = localizedProfile(t);
// Each role arrives with its `work:` reference already resolved and validated; see utils/experience.
const entries = await getRolesWithWork(locale);
const roles = entries.map(({ role }) => role);
---

<BaseLayout title={t.experienceTitle} description={t.experienceDescription(profile.name)}>
  <PageHeader
    sheet={t.experienceSheet}
    title={t.experienceTitle}
    lead={t.experienceLead(profile.experience, profile.location)}
  />

  {roles.length > 0 && (
    <div class="page">
      <Timeline roles={roles} now={profile.revision} />
    </div>
  )}

  <section class="section page" aria-labelledby="chronology-heading">
    <SectionHeading
      index={1}
      id="chronology-heading"
      title={t.chronologyTitle}
      note={t.chronologyNote}
    />
    <ol class="roles" role="list">
      {entries.map(({ role, work }) => (
        <li class="role">
          <div class="when">
            <p class="meta">{formatRange(role.data.startDate, role.data.endDate, t.dates)}</p>
            <p class="meta meta-quiet">
              {formatDuration(role.data.startDate, role.data.endDate ?? profile.revision, t.dates)}
              {role.data.engagementType && ` · ${engagementLabel(t, role.data.engagementType)}`}
            </p>
          </div>
          <div class="what">
            <h3 class="role-title">{role.data.role}</h3>
            <p class="org">
              {role.data.organization}
              {role.data.organizationNote && (
                <span class="quiet"> — {role.data.organizationNote}</span>
              )}
            </p>
            <p class="summary">{role.data.summary}</p>
            <ul class="scope">
              {role.data.scope.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {role.data.technologies.length > 0 && (
              <p class="stack">
                <span class="meta meta-quiet">{t.labelStack}</span>{' '}
                {role.data.technologies.join(', ')}
              </p>
            )}
            {work && (
              <ActionLink href={workHref(work, locale)}>
                {depthLabel(t, work.data.depth)}
              </ActionLink>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section page" aria-labelledby="education-heading">
    <SectionHeading index={2} id="education-heading" title={t.credentialsTitle} />
    <div class="grid credentials">
      <div class="block">
        <h3 class="meta meta-quiet block-title">{t.educationLabel}</h3>
        <ul class="plain" role="list">
          {profile.education.map((item) => (
            <li>
              <p class="item-title">{item.title}</p>
              <p class="quiet">
                {item.institution} · {item.period}
                {item.status && ` · ${item.status}`}
              </p>
            </li>
          ))}
        </ul>
      </div>
      <div class="block">
        <h3 class="meta meta-quiet block-title">{t.certificationsLabel}</h3>
        <ul class="plain" role="list">
          {profile.certifications.map((item) => (
            <li>
              <p class="item-title">{item.title}</p>
              <p class="quiet">{item.issuer}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="block">
        <h3 class="meta meta-quiet block-title">{t.languagesLabel}</h3>
        <ul class="plain" role="list">
          {profile.languages.map((item) => (
            <li>
              <p class="item-title">{item.name}</p>
              <p class="quiet">{item.level}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="resume-action">
      <ActionLink href={localeHref('/resume/', locale)}>{t.navResume}</ActionLink>
    </p>
  </section>
</BaseLayout>

<style>
  @layer components {
    .roles {
      display: grid;
    }

    .role {
      display: grid;
      gap: var(--space-3);
      padding-block: var(--space-5);
      border-block-start: var(--rule-strong);
    }

    .role-title {
      font-size: var(--text-h3);
    }

    .org {
      margin-block-start: 0.2rem;
      font-weight: 600;
    }

    .quiet {
      color: var(--text-secondary);
      font-weight: 400;
    }

    .summary {
      margin-block-start: var(--space-3);
      max-inline-size: var(--measure-caption);
    }

    .scope {
      margin-block: var(--space-3);
      padding-inline-start: 1.1em;
      max-inline-size: var(--measure-caption);
      list-style: disc; /* prose list: the reset removes markers from classed lists */
    }

    .scope li::marker {
      color: var(--signal);
    }

    .scope li + li {
      margin-block-start: 0.3rem;
    }

    .stack {
      font-size: var(--text-small);
      margin-block-end: var(--space-3);
    }

    .stack .meta {
      margin-inline-end: var(--space-2);
    }

    .credentials {
      row-gap: var(--space-5);
    }

    .block {
      grid-column: 1 / -1;
    }

    .block-title {
      padding-block-end: var(--space-2);
      border-block-end: var(--rule-ink);
    }

    .plain {
      display: grid;
    }

    .plain li {
      padding-block: var(--space-3);
      border-block-end: var(--rule);
    }

    .item-title {
      font-weight: 600;
      line-height: 1.35;
    }

    .resume-action {
      margin-block-start: var(--space-6);
    }

    @media (min-width: 48rem) {
      .role {
        grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
        column-gap: var(--grid-gutter);
      }

      .block {
        grid-column: span 4;
      }
    }

    @media (min-width: 64rem) {
      .role {
        grid-template-columns: repeat(12, minmax(0, 1fr));
      }

      .when {
        grid-column: 1 / span 3;
      }

      .what {
        grid-column: 4 / span 8;
      }

      .block:nth-child(1) {
        grid-column: 1 / span 5;
      }

      .block:nth-child(2) {
        grid-column: 6 / span 4;
      }

      .block:nth-child(3) {
        grid-column: 10 / span 3;
      }
    }
  }
</style>
