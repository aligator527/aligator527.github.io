---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizedProfile } from '../../data/profile';
import { localize } from '../../i18n/ui';
import { formatRange } from '../../utils/dates';
import { getRoles } from '../../utils/experience';
import { engagementLabel } from '../../utils/work';
import { RESUME_PDF_PATH, hasResumePdf } from '../../utils/resume';
import { withBase } from '../../utils/url';
import { localePaths } from '../../utils/i18n';
/*
 * One route per locale. English is the `undefined` rest parameter, so this file emits `/resume/` —
 * not `/en/resume/` — and the indexed URL is unchanged. See `localePaths()`.
 */
export const getStaticPaths = localePaths satisfies GetStaticPaths;

const { locale, t } = localize(Astro.url);
const profile = localizedProfile(t);
const roles = await getRoles(locale);
const pdfAvailable = hasResumePdf();
---

<BaseLayout title={t.navResume} description={t.resumeDescription(profile.name)}>
  <article class="resume page" aria-labelledby="resume-name">
    <header class="resume-head">
      <p class="meta meta-quiet sheet">{t.resumeSheet(profile.revision.replace('-', '/'))}</p>
      <h1 id="resume-name">{profile.name}</h1>
      <p class="descriptor">{profile.descriptor}</p>
      <ul class="contact">
        <li>{profile.location}</li>
        <li>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </li>
        <li>
          <a href={profile.github.href}>{profile.github.label}</a>
        </li>
        <li>
          <a href={profile.linkedin.href}>{profile.linkedin.label}</a>
        </li>
      </ul>
      {pdfAvailable && (
        <p class="download">
          {/* The PDF is one shared file, so it goes through withBase() and never gains a locale. */}
          <a href={withBase(`/${RESUME_PDF_PATH}`)} data-testid="resume-pdf">
            {t.resumeDownload}
            <span aria-hidden="true"> ↓</span>
          </a>
        </p>
      )}
    </header>

    <section aria-labelledby="summary-heading" class="block">
      <h2 id="summary-heading" class="meta">
        {t.resumeSummaryHeading}
      </h2>
      <p>{t.resumeSummary(profile.experience)}</p>
    </section>

    <section aria-labelledby="experience-heading" class="block">
      <h2 id="experience-heading" class="meta">
        {t.resumeExperienceHeading}
      </h2>
      <ol class="entries" role="list">
        {roles.map((role) => (
          <li class="entry">
            <div class="entry-head">
              <h3>
                {role.data.role}
                <span class="org">
                  {' '}
                  · {role.data.organization}
                  {role.data.organizationNote && ` (${role.data.organizationNote})`}
                </span>
              </h3>
              <p class="meta meta-quiet">
                {formatRange(role.data.startDate, role.data.endDate, t.dates)}
                {role.data.engagementType && ` · ${engagementLabel(t, role.data.engagementType)}`}
              </p>
            </div>
            <p>{role.data.summary}</p>
            <ul>
              {role.data.scope.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="skills-heading" class="block">
      <h2 id="skills-heading" class="meta">
        {t.resumeTechnologiesHeading}
      </h2>
      <dl class="skills">
        {profile.technologies.map((group) => (
          <div>
            <dt>{group.area}</dt>
            <dd>{group.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="edu-heading" class="block">
      <h2 id="edu-heading" class="meta">
        {t.resumeCredentialsHeading}
      </h2>
      <ul class="compact">
        {profile.education.map((item) => (
          <li>
            {item.title}, {item.institution} ({item.period}
            {item.status && `, ${item.status.toLowerCase()}`})
          </li>
        ))}
        {profile.certifications.map((item) => (
          <li>
            {item.title} ({item.issuer})
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="lang-heading" class="block">
      <h2 id="lang-heading" class="meta">
        {t.resumeLanguagesHeading}
      </h2>
      <ul class="compact">
        {profile.languages.map((item) => (
          <li>
            {item.name}: {item.level}
          </li>
        ))}
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  @layer components {
    .resume {
      max-inline-size: 52rem;
      padding-block: var(--space-6) 0;
    }

    .sheet {
      padding-block-end: var(--space-2);
      margin-block-end: var(--space-4);
      border-block-end: var(--rule);
    }

    .descriptor {
      font-size: var(--text-h3);
      margin-block-start: var(--space-1);
    }

    .contact {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--space-4);
      margin-block-start: var(--space-3);
      padding: 0;
      list-style: none;
    }

    .contact a,
    .download a {
      display: inline-block;
      padding-block: 0.625rem;
    }

    .download a {
      font-weight: 600;
    }

    /* The column is 52rem; the lines inside it are capped per script — see `--measure-prose`. */
    .block :is(p, li) {
      max-inline-size: var(--measure-prose);
    }

    .block {
      margin-block-start: var(--space-6);
      padding-block-start: var(--space-2);
      border-block-start: var(--rule-ink);
    }

    .block > h2 {
      margin-block-end: var(--space-3);
      font-size: var(--text-meta);
      letter-spacing: var(--tracking-meta);
    }

    .entries {
      display: grid;
      gap: var(--space-5);
    }

    .entry-head {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0 var(--space-4);
      align-items: baseline;
      margin-block-end: var(--space-1);
    }

    .entry h3 {
      font-size: var(--text-body-lg);
      letter-spacing: 0;
    }

    .org {
      font-weight: 400;
    }

    .entry ul,
    .compact {
      margin-block-start: var(--space-1);
      padding-inline-start: 1.1em;
      list-style: disc; /* prose list: the reset removes markers from classed lists */
    }

    .skills {
      display: grid;
    }

    .skills div {
      display: grid;
      gap: 0.1rem;
      padding-block: var(--space-2);
      border-block-end: var(--rule);
    }

    .skills dt {
      font-weight: 600;
    }

    .skills dd {
      margin: 0;
    }

    @media (min-width: 48rem) {
      .skills div {
        grid-template-columns: 13rem minmax(0, 1fr);
        gap: var(--space-4);
      }
    }

    @media print {
      /* Global print rules hide the site chrome; these are résumé-specific. */
      .download {
        display: none;
      }

      :global(html) {
        font-size: 10pt;
      }

      .resume {
        max-inline-size: none;
        padding: 0;
      }

      .block {
        margin-block-start: 1.2em;
        break-inside: avoid-page;
      }

      .entry {
        break-inside: avoid;
      }

      a {
        text-decoration: none;
      }
    }
  }
</style>
