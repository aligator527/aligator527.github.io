---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/core/PageHeader.astro';
import { profile } from '../../../data/profile';
import { localize } from '../../../i18n/ui';
import { localePaths } from '../../../utils/i18n';
import MetaList from '../../../components/core/MetaList.astro';
import { getNotes, noteHref } from '../../../utils/writing';

/*
 * One route per locale. English is the `undefined` rest parameter, so this file emits `/notes/` —
 * not `/en/notes/` — and the indexed URL is unchanged. See `localePaths()`.
 */
export const getStaticPaths = localePaths satisfies GetStaticPaths;

const { locale, t } = localize(Astro.url);
const notes = await getNotes(locale);
---

<BaseLayout
  title={t.notesTitle}
  description={t.notesDescription(profile.name)}
  noindex={notes.length === 0}
>
  <PageHeader
    sheet={notes.length === 0 ? t.notesSheetEmpty : t.notesSheet}
    title={t.notesTitle}
    lead={t.notesLead}
  />
  <section class="page" aria-labelledby="notes-list">
    <h2 id="notes-list" class="visually-hidden">
      {t.notesArticlesHeading}
    </h2>
    {notes.length === 0 ? (
      <p class="empty">{t.notesEmpty}</p>
    ) : (
      <ol class="entries">
        {notes.map((note) => (
          <li class="entry">
            <p class="meta meta-quiet">
              <time datetime={note.data.publishedAt}>
                {note.data.publishedAt.replaceAll('-', '/')}
              </time>
            </p>
            <h3>
              <a href={noteHref(note, locale)}>{note.data.title}</a>
            </h3>
            <p>{note.data.summary}</p>
            <MetaList
              class="record"
              items={[
                {
                  label: t.notesTopicsLabel,
                  value: note.data.topics
                    .map((topic) => topic.replaceAll(' ', '\u00A0'))
                    .join(' · '),
                },
              ]}
            />
          </li>
        ))}
      </ol>
    )}
  </section>
</BaseLayout>

<style>
  @layer components {
    .entries {
      display: grid;
    }

    .entry {
      display: grid;
      gap: var(--space-2);
      padding-block: var(--space-4);
      border-block-start: var(--rule-strong);
      max-inline-size: var(--measure);
    }

    /* Wide enough for two columns, the row becomes a record: what it is on the left, capped at */
    /* the measure, and what it is about on the right. Below that the topics follow the summary. */
    @media (min-width: 64rem) {
      .entry {
        grid-template-columns: minmax(0, var(--measure)) minmax(0, 1fr);
        column-gap: var(--space-6);
        max-inline-size: none;
      }

      .entry > :global(.record) {
        grid-column: 2;
        grid-row: 1 / span 3;
        align-self: start;
      }
    }

    .empty {
      color: var(--text-secondary);
    }
  }
</style>
