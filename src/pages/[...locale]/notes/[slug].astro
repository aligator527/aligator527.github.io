---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/core/PageHeader.astro';
import MetaList from '../../../components/core/MetaList.astro';
import { localize } from '../../../i18n/ui';
import { EMITTED_LOCALES, localeParam } from '../../../utils/i18n';
import { getNotes, noteHref, noteSlug } from '../../../utils/writing';

/*
 * One route per locale per note. The slug is the same in every locale, which is what makes
 * `/notes/x/` and `/ja/notes/x/` a translation pair rather than two unrelated pages.
 */
export const getStaticPaths = (async () => {
  const perLocale = await Promise.all(
    EMITTED_LOCALES.map(async (locale) => {
      const notes = await getNotes(locale);
      // The pager is built per locale from that locale's own ordered list, so a translated note
      // can never page into another locale's sequence.
      return notes.map((note, index) => ({
        params: { locale: localeParam(locale), slug: noteSlug(note) },
        props: { note, previous: notes[index - 1], next: notes[index + 1] },
      }));
    }),
  );
  return perLocale.flat();
}) satisfies GetStaticPaths;

const { note, previous, next } = Astro.props;
const { Content, headings } = await render(note);
const { locale, t } = localize(Astro.url);
const sections = headings.filter((heading) => heading.depth === 2);
const noteDate = (entry: typeof note) => entry.data.publishedAt.replaceAll('-', '/');
---

<BaseLayout title={note.data.title} description={note.data.summary}>
  <article>
    <PageHeader
      sheet={`${t.noteSheet} / ${note.data.publishedAt.replaceAll('-', '/')}`}
      title={note.data.title}
      lead={note.data.summary}
    />
    <div class="page grid">
      <div class="rail">
        <MetaList
          items={[
            {
              label: t.notesTopicsLabel,
              /* A topic is one token in a two-column rail, so it must not break across lines. */
              value: note.data.topics.map((topic) => topic.replaceAll(' ', ' ')).join(' · '),
            },
          ]}
        />
      </div>
      <div class="prose document">
        <Content />
      </div>
      {sections.length > 1 && (
        /*
         * Navigation while reading, opposite the topics, which are orientation before it. The
         * numbered sections are already a coordinate system; this is the index to it, and it is
         * the column the header leaves empty on a wide screen.
         */
        <nav class="contents" aria-label={t.contentsLabel}>
          <p class="meta meta-quiet">{t.contentsHeading}</p>
          <ol>
            {sections.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </div>
    <nav class="grid pager" aria-label={t.notesMore}>
      {previous ? (
        <a class="pager-link prev" href={noteHref(previous, locale)}>
          <span class="meta meta-quiet">{t.pagerPrevious(noteDate(previous))}</span>
          <span class="pager-title">{previous.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class="pager-link next" href={noteHref(next, locale)}>
          <span class="meta meta-quiet">{t.pagerNext(noteDate(next))}</span>
          <span class="pager-title">{next.data.title}</span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>

<style>
  @layer components {
    /* The note's text starts in the same column as the title above it: `PageHeader` places its */
    /* title and lede at `3 / span 8` on wide screens, and a full-width body under an indented */
    /* lede reads as a second document rather than the continuation of the first. */
    .document {
      grid-column: 1 / -1;
    }

    /* The topics are the one piece of orientation the body cannot carry itself. They sit in the */
    /* margin beside the first paragraph, which is the column the header leaves empty. */
    .rail {
      grid-column: 1 / -1;
      margin-block-end: var(--space-4);
    }

    /* Hidden where there is no margin to put it in, as on a case study: on a phone a contents */
    /* list sits between the reader and the first paragraph, and repeats what scrolling gives. */
    .contents {
      display: none;
    }

    .contents ol {
      display: grid;
      gap: var(--space-1);
      margin-block-start: var(--space-2);
      padding: 0;
      list-style: none;
      font-size: var(--text-small);
    }

    .pager {
      margin-block-start: var(--space-8);
      row-gap: var(--space-3);
    }

    .pager > * {
      grid-column: 1 / -1;
    }

    .pager-link {
      display: grid;
      gap: var(--space-1);
      padding-block: var(--space-3);
      border-block-start: var(--rule-ink);
      text-decoration: none;
    }

    .pager-link:hover .pager-title {
      text-decoration: underline;
      text-decoration-color: var(--signal);
    }

    .pager-title {
      font-size: var(--text-h3);
      font-weight: 600;
    }

    @media (min-width: 64rem) {
      .document {
        grid-column: 3 / span 8;
      }

      .rail {
        grid-column: 1 / span 2;
        margin-block-end: 0;
      }

      /* The margin the header leaves empty. Sticky, because its use is during the read. */
      .contents {
        display: block;
        grid-column: 11 / -1;
        grid-row: 1;
        align-self: start;
        position: sticky;
        inset-block-start: var(--space-4);
      }

      .pager > .prev,
      .pager > span {
        grid-column: 1 / span 6;
      }

      .pager > .next {
        grid-column: 7 / -1;
      }
    }
  }
</style>
