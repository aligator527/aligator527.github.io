---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/core/PageHeader.astro';
import SectionHeading from '../components/core/SectionHeading.astro';
import ActionLink from '../components/core/ActionLink.astro';
import { profile } from '../data/profile';
import { withBase } from '../utils/url';
---

<BaseLayout
  title="About"
  description="Ivan Dolgov is a Tokyo-based Tech Lead and full-stack engineer working in Russian, Japanese, and English."
>
  <PageHeader
    sheet="Sheet 03 / About"
    title="About"
    lead="Tech Lead and full-stack engineer in Tokyo, working across requirements, architecture, implementation, and release."
  />

  <section class="page" aria-labelledby="background-heading">
    <SectionHeading index={1} id="background-heading" title="Background" />
    <div class="grid">
      <div class="prose body">
        <p>
          I have {profile.experience} of professional experience. Since September 2026 I have been
          Tech Lead for a{' '}
          <a href={withBase('/work/next-generation-wms/')}>
            next-generation warehouse management system
          </a>
          at Frameworx, part of Daiwa House Group, where I am responsible for technical planning and
          architecture.
        </p>
        <p>
          Before that I worked on contract engagements and client projects. I led 0→1 development of
          an <a href={withBase('/work/ai-chat-platform/')}>AI chat game platform</a> at Ikigai,
          worked full-stack on a{' '}
          <a href={withBase('/work/packaging-saas/')}>production SaaS for the packaging industry</a>{' '}
          at Nagashima Konpo, and led{' '}
          <a href={withBase('/work/client-delivery/')}>client web projects</a> at Flaretech.
        </p>
        <p>
          I started in August 2021 as an independent full-stack engineer, delivering web
          applications and business systems in one- to two-person teams and handling requirements
          directly with clients.
        </p>
        <p>
          I am currently studying for an MBA at GLOBIS University, and I am taking part in the
          Global Consumer Intelligence program at the Matsuo–Iwasawa Laboratory, The University of
          Tokyo.
        </p>
      </div>
    </div>
  </section>

  <section class="section page" aria-labelledby="languages-heading">
    <SectionHeading
      index={2}
      id="languages-heading"
      title="Languages"
      note="My day-to-day working environment is Japanese enterprise engineering, and I can run technical work in English or Russian as well."
    />
    <dl class="languages">
      {profile.languages.map((language) => (
        <div class="language">
          <dt>
            <span class="meta signal-text code">{language.code}</span>
            <span class="name">{language.name}</span>
          </dt>
          <dd>{language.level}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section page" aria-labelledby="engage-heading">
    <SectionHeading index={3} id="engage-heading" title="Working together" />
    <div class="grid">
      <div class="prose body">
        <p>{profile.availability}</p>
        <p>
          The best starting point is a short email describing the system, where it is today, and
          what needs to change. I reply from <a href={`mailto:${profile.email}`}>{profile.email}</a>
          .
        </p>
      </div>
      <p class="actions">
        <ActionLink href={withBase('/work/')}>Selected work</ActionLink>
        <ActionLink href={withBase('/resume/')}>Résumé</ActionLink>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  @layer components {
    .body,
    .actions {
      grid-column: 1 / -1;
    }

    .body {
      font-size: var(--text-body-lg);
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3) var(--space-5);
      margin-block-start: var(--space-5);
    }

    .languages {
      display: grid;
    }

    .language {
      display: grid;
      gap: var(--space-1);
      padding-block: var(--space-4);
      border-block-start: var(--rule-strong);
    }

    .language dt {
      display: flex;
      gap: var(--space-3);
      align-items: baseline;
    }

    .name {
      font-size: var(--text-h3);
      font-weight: 600;
    }

    .code {
      min-inline-size: 2rem;
    }

    .language dd {
      margin: 0;
      color: var(--text-secondary);
    }

    @media (min-width: 64rem) {
      .body,
      .actions {
        grid-column: 3 / span 7;
      }

      .language {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--grid-gutter);
        align-items: baseline;
      }

      .language dt {
        grid-column: 3 / span 4;
      }

      .language dd {
        grid-column: 7 / -1;
      }
    }
  }
</style>
