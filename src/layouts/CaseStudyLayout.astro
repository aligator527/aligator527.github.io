---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import GlossaryTerm from '../components/core/GlossaryTerm.astro';
import StructuredData from '../components/core/StructuredData.astro';
import MetaList from '../components/core/MetaList.astro';
import EnvironmentMatrix from '../components/diagrams/EnvironmentMatrix.astro';
import LayerDiagram from '../components/diagrams/LayerDiagram.astro';
import { profile } from '../data/profile';
import { localize } from '../i18n/ui';
import { localeHref } from '../utils/i18n';
import { engagementLabel, statusLabel, workHref, workPeriod, type WorkEntry } from '../utils/work';

interface Props {
  entry: WorkEntry;
  headings: MarkdownHeading[];
  previous: WorkEntry | undefined;
  next: WorkEntry | undefined;
}

const { entry, headings, previous, next } = Astro.props;
const { locale, t } = localize(Astro.url);
const { data } = entry;
const period = workPeriod(entry, profile.revision, t.dates);
const sections = headings.filter((heading) => heading.depth === 2);

// The facts a visitor needs first sit in the header, which also keeps them above the narrative on
// narrow screens. The remainder stays in the rail, which follows the document when it unstacks.
const headFacts = [
  { label: t.labelRole, value: data.role },
  ...(data.organization ? [{ label: t.labelOrganization, value: data.organization }] : []),
  { label: t.labelPeriod, value: period.range, note: period.duration },
  { label: t.labelStatus, value: statusLabel(t, data.status) },
];

const railFacts = [
  ...(data.engagementType
    ? [{ label: t.labelEngagement, value: engagementLabel(t, data.engagementType) }]
    : []),
  ...(data.teamSize ? [{ label: t.labelTeam, value: data.teamSize }] : []),
  { label: t.labelDomain, value: data.domains.join(', ') },
  ...(data.technologies.length
    ? [{ label: t.labelStack, value: data.technologies.join(', ') }]
    : []),
];

const diagramVariant = {
  'scope-map': 'scope',
  'stack-left': 'stack',
  'stack-right': 'stack',
  delivery: 'sequence',
} as const;
---

<BaseLayout title={data.title} description={data.description ?? data.summary}>
  <StructuredData
    slot="head"
    kind="work"
    work={{ code: data.code, title: data.title, href: workHref(entry, locale) }}
  />
  <article class="study page" aria-labelledby="study-title">
    <header class="grid study-head">
      <p class="meta crumb">
        <a href={localeHref('/work/', locale)}>{t.navWork}</a>
        <span aria-hidden="true">/</span>
        <span class="signal-text">{data.code}</span>
      </p>
      <h1 id="study-title" class="title">
        {data.title}
      </h1>
      <p class="lead">{data.summary}</p>
      {data.depth === 'brief' && (
        <p class="brief-note">
          <span class="meta">{t.workDepth.brief}</span>
          <span>{t.studyBriefNote}</span>
        </p>
      )}
      <MetaList class="head-facts" items={headFacts} layout="inline" />
    </header>

    <div class="grid study-body">
      <aside class="rail" aria-label={t.studyDetails}>
        <MetaList items={railFacts} />
        {sections.length > 1 && (
          <nav class="contents" aria-label={t.studySections}>
            <p class="meta meta-quiet">{t.studyContents}</p>
            <ol>
              {sections.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}
        {data.glossary.length > 0 && (
          /*
           * Context, not navigation: terms this project depends on that a reader outside Japan or
           * outside logistics has no reason to know. They sit in the rail because the body is
           * Markdown — it cannot host a component — and because the rail is where this page
           * already keeps the facts you read before the prose.
           */
          <section class="context" aria-labelledby={`context-${entry.id}`}>
            <p class="meta meta-quiet" id={`context-${entry.id}`}>
              {t.studyContext}
            </p>
            <ul role="list">
              {data.glossary.map((id) => (
                <li>
                  <GlossaryTerm id={id} term={t.glossaryTerm[id]} anchor={`context-${id}`} />
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>

      <div class="document">
        {data.environments ? (
          <EnvironmentMatrix class="figure" {...data.environments} />
        ) : (
          <LayerDiagram
            class="figure"
            layers={data.diagram.layers}
            caption={data.diagram.caption}
            variant={diagramVariant[data.heroVariant]}
            prefix={
              data.heroVariant === 'delivery' ? 'S' : data.heroVariant === 'scope-map' ? 'A' : 'L'
            }
          />
        )}
        <div class="prose">
          <slot />
        </div>
      </div>
    </div>

    <nav class="grid pager" aria-label={t.studyMoreWork}>
      {previous ? (
        <a class="pager-link prev" href={workHref(previous, locale)}>
          <span class="meta meta-quiet">{t.pagerPrevious(previous.data.code)}</span>
          <span class="pager-title">{previous.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class="pager-link next" href={workHref(next, locale)}>
          <span class="meta meta-quiet">{t.pagerNext(next.data.code)}</span>
          <span class="pager-title">{next.data.title}</span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>

<style>
  @layer components {
    .study-head {
      padding-block: var(--space-5) var(--space-6);
      row-gap: var(--space-4);
    }

    .study-head > *,
    .study-body > * {
      grid-column: 1 / -1;
      min-inline-size: 0;
    }

    .study-body > .rail,
    .study-body > .document {
      grid-column: 1 / -1;
    }

    .crumb {
      display: flex;
      gap: var(--space-2);
      align-items: center;
      padding-block-end: var(--space-2);
      border-block-end: var(--rule);
    }

    .crumb a {
      display: inline-flex;
      align-items: center;
      min-block-size: var(--tap-min);
      margin-block: calc((var(--tap-min) - 1.4em) / -2);
    }

    .title {
      max-inline-size: var(--measure-title);
    }

    .lead {
      font-size: var(--text-body-lg);
      max-inline-size: var(--measure-lede-wide);
    }

    .brief-note {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--space-3);
      align-items: baseline;
      max-inline-size: var(--measure-caption);
      padding: var(--space-2) var(--space-3);
      border: 1px dashed var(--line-strong);
      font-size: var(--text-small);
      color: var(--text-secondary);
    }

    .brief-note .meta {
      color: var(--signal-text);
    }

    .study-body {
      row-gap: var(--space-6);
      padding-block-start: var(--space-4);
      border-block-start: var(--rule-ink);
    }

    .study-body > .document {
      order: -1;
    }

    .contents {
      display: none;
    }

    .context {
      margin-block-start: var(--space-4);
      padding-block-start: var(--space-2);
      border-block-start: var(--rule);
    }

    .context ul {
      display: grid;
      gap: var(--space-3);
      margin-block-start: var(--space-2);
      padding: 0;
      list-style: none;
      font-size: var(--text-small);
    }

    /* In the rail the term is already the list item, so a note repeating it as a label is one */
    /* word of noise beside another. In a sentence the label is what ties the note to its word, */
    /* so it is hidden only here — and only where the note and the term are visible together. */
    @media (min-width: 64rem) {
      .context :global(.note-label) {
        display: none;
      }

      .context :global(.note) {
        float: none;
        inline-size: auto;
        margin-inline-start: 0;
      }
    }

    .contents ol {
      display: grid;
      margin-block-start: var(--space-2);
      padding: 0;
      list-style: none;
    }

    .contents a {
      display: flex;
      align-items: center;
      min-block-size: var(--tap-min);
      font-size: var(--text-small);
      text-decoration: none;
      border-block-start: var(--rule);
    }

    .contents a:hover {
      text-decoration: underline;
      text-decoration-color: var(--signal);
    }

    .document > :global(.figure) {
      margin-block-end: var(--space-6);
    }

    .prose :global(h2) {
      scroll-margin-block-start: var(--space-4);
      padding-block-start: var(--space-3);
      border-block-start: var(--rule);
    }

    .prose :global(h2:first-child) {
      margin-block-start: 0;
    }

    .pager {
      margin-block-start: var(--space-8);
      row-gap: var(--space-3);
    }

    .pager > * {
      grid-column: 1 / -1;
    }

    .pager-link {
      display: grid;
      gap: var(--space-1);
      padding-block: var(--space-3);
      border-block-start: var(--rule-ink);
      text-decoration: none;
    }

    .pager-link:hover .pager-title {
      text-decoration: underline;
      text-decoration-color: var(--signal);
    }

    .pager-title {
      font-size: var(--text-h3);
      font-weight: 600;
    }

    @media (min-width: 48rem) {
      .pager > .prev,
      .pager > span {
        grid-column: 1 / span 4;
      }

      .pager > .next {
        grid-column: 5 / -1;
        text-align: end;
      }
    }

    @media (min-width: 64rem) {
      .study-head > .crumb {
        grid-column: 1 / -1;
      }

      .study-head > .title,
      .study-head > .lead,
      .study-head > .brief-note,
      .study-head > :global(.head-facts) {
        grid-column: 4 / -1;
      }

      .study-body > .document {
        order: 0;
      }

      .contents {
        display: block;
        margin-block-start: var(--space-5);
      }

      .study-body > .rail {
        grid-column: 1 / span 3;
        align-self: start;
        position: sticky;
        inset-block-start: var(--space-4);
      }

      .study-body > .document {
        grid-column: 4 / -1;
      }

      .pager > .prev,
      .pager > span {
        grid-column: 1 / span 6;
      }

      .pager > .next {
        grid-column: 7 / -1;
      }
    }
  }
</style>
