---
import { Font } from 'astro:assets';
import SiteHeader from '../components/navigation/SiteHeader.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';
import { profile } from '../data/profile';
import { withBase } from '../utils/url';
import { OG_LOCALE, alternates, isIndexable, localesFor, logicalPath } from '../utils/i18n';
/*
 * Keep this import where it is, and add new imports BELOW it.
 *
 * Astro orders a page's <link rel="stylesheet"> tags by each CSS module's index among its importer's
 * imports (`cssOrder` in astro/dist/core/build/runtime.js). Moving global.css one position later is
 * enough to emit it AFTER a page's own scoped styles — which, inside the shared `components` layer,
 * reverses which of two equally specific rules wins. Verified: adding an import above this line
 * flipped the two stylesheets in dist/index.html.
 */
import '../styles/global.css';
import { localize } from '../i18n/ui';

interface Props {
  title?: string;
  description: string;
  /** Keeps placeholder routes (e.g. an empty Lab) out of search indexes. */
  noindex?: boolean;
}

const { title, description, noindex: noindexProp = false } = Astro.props;
const { locale, t } = localize(Astro.url);
/*
 * A locale is built before it is advertised, so a page is `noindex` either because its route is a
 * placeholder (the `noindex` prop, e.g. an empty Lab) or because its locale is not published yet.
 * `isIndexable()` is the same predicate the sitemap filter and the hreflang set read, so the three
 * can never disagree about whether a page is public — see src/utils/i18n.ts.
 */
const noindex = noindexProp || !isIndexable(locale);
const pageTitle = title
  ? `${title} — ${profile.name}`
  : t.siteTitle(profile.name, profile.descriptor);
// Self-referencing, and the only canonical on the page: scripts/check-i18n.mjs enforces both.
// Locales are linked by hreflang alternates (`alternates()` in src/utils/i18n.ts), not by this tag.
const canonical = new URL(Astro.url.pathname, Astro.site);
/*
 * The hreflang cluster. Every published locale of this page links to every other AND to itself, and
 * one `x-default` points at English — Google discards a cluster where a single link is missing or
 * not reciprocated, so these are generated from one helper rather than written per page.
 *
 * Suppressed on a `noindex` page: advertising alternates for a page that asks not to be indexed is
 * the contradictory half-published state `isIndexable()` exists to prevent. With one published
 * locale the helper returns that locale plus `x-default`, which is a valid but pointless cluster,
 * so it is skipped until a second locale is published.
 */
const pagePath = logicalPath(Astro.url.pathname);
const localeAlternates = alternates(pagePath, localesFor(pagePath));
const showAlternates = !noindex && localeAlternates.length > 2;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style is:inline>
      @layer reset, tokens, base, layout, components, utilities;
    </style>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {showAlternates &&
      localeAlternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.hreflang}
          href={new URL(alternate.href, Astro.site)}
        />
      ))}
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#f2f0e8" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/* Open Graph wants `language_TERRITORY`; the bare `en` this previously emitted is not a valid
        value. This is a deliberate change to the published English pages: `en` -> `en_US`. */}
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta property="og:image" content={new URL(withBase('/og.png'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.descriptor}, Tokyo`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    {/*
      One sans per locale, and only that locale's faces are emitted and preloaded (ADR-0006).
      Preloading is high priority, so a face a page cannot use costs the real LCP element its
      bandwidth: Russian is set in Golos Text and never touches Instrument Sans, and Japanese is set
      in a system stack that downloads nothing, where three preloaded Latin faces would be three
      wasted critical requests. Japanese still declares Instrument Sans — its Latin runs (DynamoDB,
      P01, REV.01) are the site's Latin voice — but declares it without preload, because those runs
      are a minority of the page and can arrive late.
    */}
    {locale === 'ru' ? (
      /*
       * Golos Text ships one file per weight AND subset, so an unfiltered weight list preloads six
       * files (58KB). These four are the faces a Russian page paints first, measured on the built
       * page: the Cyrillic 400/600/700 it is written in, plus Latin 700 for the wordmark, which is
       * the largest-contentful-paint element at desktop widths (at 390px it is the Cyrillic 400
       * promise line). 34KB against English's 51KB; the Latin 400/600 arrive on demand.
       */
      <Font
        cssVariable="--font-golos-text"
        preload={[
          { weight: 400, subset: 'cyrillic' },
          { weight: 600, subset: 'cyrillic' },
          { weight: 700, subset: 'cyrillic' },
          { weight: 700, subset: 'latin' },
        ]}
      />
    ) : locale === 'ja' ? (
      <Font cssVariable="--font-instrument-sans" />
    ) : (
      <Font
        cssVariable="--font-instrument-sans"
        preload={[{ weight: 400 }, { weight: 600 }, { weight: 700 }]}
      />
    )}
    <Font cssVariable="--font-ibm-plex-mono" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skipToContent}
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  @layer components {
    .skip-link {
      position: absolute;
      inset-block-start: var(--space-2);
      inset-inline-start: var(--space-2);
      z-index: 10;
      padding: var(--space-2) var(--space-3);
      background: var(--surface-ink);
      color: var(--text-inverse);
      font-family: var(--font-mono);
      font-size: var(--text-meta);
      text-transform: uppercase;
      letter-spacing: var(--tracking-meta);
      transform: translateY(calc(-100% - var(--space-4)));
    }

    .skip-link:focus-visible {
      transform: none;
    }

    main:focus {
      outline: none;
    }
  }
</style>
