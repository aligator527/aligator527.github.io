---
/**
 * Deployment topology as a matrix: each separately deployed unit is a row, each environment it is
 * promoted through is a column. The point it makes is multiplication — every change and every
 * migration has to travel units × stages. On narrow containers the rows stack and each row keeps
 * its own labelled stage sequence, so no column header is needed to read it.
 */
import { localize } from '../../i18n/ui';

interface Props {
  caption: string;
  stages: string[];
  units: { name: string; role: string; items: string[] }[];
  shared?: { label: string; items: string[] } | undefined;
  class?: string;
}

const { caption, stages, units, shared, class: className } = Astro.props;
const { t } = localize(Astro.url);
---

<figure class:list={['environment-matrix', className]} style={`--stage-count: ${stages.length}`}>
  <ol class="units">
    {units.map((unit, index) => (
      <li class="unit">
        <p class="unit-name">
          <span class="meta unit-id">R{index + 1}</span>
          <span class="meta">{unit.name}</span>
        </p>
        <div class="unit-body">
          <p class="role">{unit.role}</p>
          {unit.items.length > 0 && (
            <ul class="items" role="list">
              {unit.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </div>
        <ol class="stages" aria-label={t.environmentsInOrder(unit.name)}>
          {stages.map((stage) => (
            <li>{stage}</li>
          ))}
        </ol>
      </li>
    ))}
  </ol>
  {shared && (
    <div class="shared">
      <p class="meta">{shared.label}</p>
      <ul class="items" role="list">
        {shared.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  )}
  <figcaption class="caption">{caption}</figcaption>
</figure>

<style>
  @layer components {
    .environment-matrix {
      margin: 0;
      container-type: inline-size;
    }

    .units {
      display: grid;
    }

    .unit {
      display: grid;
      gap: var(--space-2);
      padding-block: var(--space-3);
      border-block-start: var(--rule-strong);
    }

    .unit-name {
      display: flex;
      gap: var(--space-2);
      align-items: baseline;
    }

    .unit-id {
      color: var(--signal-text);
      min-inline-size: 2.2em;
    }

    .role {
      font-size: var(--text-small);
      max-inline-size: 40ch;
    }

    .items {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1);
      margin-block-start: var(--space-1);
    }

    .items li {
      padding: 0.3rem 0.6rem;
      border: var(--rule-strong);
      background: var(--surface-paper-elevated);
      font-size: var(--text-small);
      line-height: 1.3;
    }

    /* Stages read as a promotion path: boxes joined by arrows, production drawn in ink. */
    .stages {
      display: grid;
      /* Sized to content when narrow, so the longest stage name never clips. */
      grid-template-columns: repeat(var(--stage-count), auto);
      justify-content: start;
      gap: var(--space-3);
      padding: 0;
      list-style: none;
    }

    .stages li {
      position: relative;
      padding: 0.3rem 0.5rem;
      border: 1px dashed var(--line-strong);
      font-family: var(--font-mono);
      font-size: var(--text-small);
      text-align: center;
    }

    .stages li:last-child {
      border: var(--rule-ink);
    }

    .stages li:not(:last-child)::after {
      content: '→';
      position: absolute;
      inset-block-start: 50%;
      inset-inline-end: calc(var(--space-3) / -2 - 0.5ch);
      translate: 0 -50%;
      color: var(--signal-text);
    }

    .shared {
      display: grid;
      gap: var(--space-1);
      padding-block: var(--space-3);
      border-block: var(--rule-ink);
    }

    .caption {
      margin-block-start: var(--space-3);
      font-size: var(--text-small);
      color: var(--text-secondary);
      max-inline-size: 60ch;
    }

    /* Wide: stage boxes line up across rows into columns, which is what makes it a matrix. */
    @container (min-width: 40rem) {
      .unit {
        grid-template-columns: 7rem minmax(0, 1fr) minmax(max-content, 1.3fr);
        column-gap: var(--space-3);
        align-items: start;
      }

      .stages {
        grid-template-columns: repeat(var(--stage-count), minmax(max-content, 1fr));
      }

      .shared {
        grid-template-columns: 7rem minmax(0, 1fr);
        column-gap: var(--space-3);
        align-items: baseline;
      }

      .shared .items {
        margin-block-start: 0;
      }
    }
  }
</style>
