---
import LanguageSwitch from './LanguageSwitch.astro';
import { profile } from '../../data/profile';
import { localize } from '../../i18n/ui';
import { localeHref, logicalPath } from '../../utils/i18n';
import { getPrimaryNav } from '../../utils/navigation';
import { isCurrent } from '../../utils/url';

const { locale, t } = localize(Astro.url);
/*
 * Current-page comparisons happen on logical paths: the deployment base AND the locale prefix are
 * stripped from both sides. Without the locale strip, /ru/work/ would compare against the nav's
 * /ru/work/ href only by accident, and a mismatch in either direction silently drops aria-current.
 */
const path = logicalPath(Astro.url.pathname);
const nav = await getPrimaryNav(locale);
const homeCurrent = isCurrent('/', path);
---

<header class="site-header">
  <div class="page bar">
    <a class="wordmark" href={localeHref('/', locale)} aria-current={homeCurrent}>
      <span class="wordmark-name">{profile.name}</span>
      <span class="meta meta-quiet wordmark-role">{profile.descriptor}</span>
    </a>
    <nav class="primary" aria-label={t.navPrimary}>
      <ul class="nav-list" role="list">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.path, path)}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        class="resume-link"
        href={localeHref('/resume/', locale)}
        aria-current={isCurrent('/resume/', path)}
      >
        {t.navResume}
      </a>
      <LanguageSwitch />
    </nav>
  </div>
</header>

<style>
  @layer components {
    .site-header {
      border-block-end: var(--rule-ink);
    }

    .bar {
      display: flex;
      flex-wrap: wrap;
      align-items: stretch;
      justify-content: space-between;
      column-gap: var(--space-5);
    }

    .wordmark {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-block-size: 3.5rem;
      padding-block: var(--space-1);
      text-decoration: none;
    }

    .wordmark-name {
      font-weight: 700;
      font-size: 1.0625rem;
      letter-spacing: -0.01em;
      line-height: 1.2;
    }

    .wordmark-role {
      display: none;
    }

    .primary {
      display: flex;
      align-items: stretch;
      gap: var(--space-4);
    }

    .nav-list {
      display: flex;
      gap: var(--space-4);
    }

    .nav-list a,
    .resume-link {
      display: flex;
      align-items: center;
      min-block-size: var(--tap-min);
      block-size: 100%;
      font-size: var(--text-small);
      text-decoration: none;
      border-block-end: 3px solid transparent;
      padding-block-start: 3px;
      transition: border-color var(--duration-fast) var(--ease-standard);
    }

    .nav-list a:hover,
    .resume-link:hover {
      border-block-end-color: var(--line-strong);
    }

    .nav-list a[aria-current='page'],
    .resume-link[aria-current='page'] {
      border-block-end-color: var(--signal);
      font-weight: 600;
    }

    .resume-link {
      padding-inline-start: var(--space-4);
      border-inline-start: var(--rule);
    }

    @media (forced-colors: active) {
      .nav-list a,
      .resume-link {
        border-block-end-color: Canvas;
      }

      .nav-list a[aria-current='page'],
      .resume-link[aria-current='page'] {
        border-block-end-color: Highlight;
        text-decoration: underline;
        text-decoration-thickness: 2px;
      }
    }

    /* Narrow screens: wordmark on its own row, all links on a second full-width row. */
    @media (max-width: 35.99rem) {
      .primary {
        flex-basis: 100%;
        justify-content: space-between;
        gap: var(--space-2);
        border-block-start: var(--rule);
      }

      .nav-list {
        gap: var(--space-3);
      }

      .resume-link {
        padding-inline-start: var(--space-3);
      }
    }

    @media (min-width: 64rem) {
      .wordmark {
        min-block-size: 4.5rem;
      }

      .wordmark-role {
        display: block;
      }
    }
  }
</style>
