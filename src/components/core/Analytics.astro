---
import { measurementId } from '../../data/analytics';

/*
 * The gtag.js snippet, verbatim apart from the ID, which is read from one module.
 *
 * `is:inline` on both tags, for different reasons. On the loader, because Astro would otherwise
 * rewrite a bundled script's URL and this one has to stay Google's. On the configuration block,
 * because a bundled script becomes a module, and a module's `function gtag()` is scoped to that
 * module instead of to `window` — where Google's loader and every later `gtag(...)` call look for
 * it. `is:inline` is also what keeps this out of the build's JavaScript graph entirely: no bundle
 * is emitted, so a build without `ANALYTICS=on` ships exactly what it shipped before.
 */
const id = measurementId();
---

{id && (
  <Fragment>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`}></script>
    <script
      is:inline
      set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${id}');`}
    ></script>
  </Fragment>
)}
