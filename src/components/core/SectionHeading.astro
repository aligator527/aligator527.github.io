---
interface Props {
  /** Two-digit section index rendered as `01/`. */
  index: number;
  id: string;
  title: string;
  /** Optional one-line orientation text aligned to the right of the rule. */
  note?: string;
}

const { index, id, title, note } = Astro.props;
const label = `${String(index).padStart(2, '0')}/`;
---

<header class="section-heading">
  <p class="meta index" aria-hidden="true">
    {label}
  </p>
  <h2 id={id}>{title}</h2>
  {note && <p class="note">{note}</p>}
</header>

<style>
  @layer components {
    .section-heading {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
      padding-block-start: var(--space-3);
      border-block-start: var(--rule-ink);
      margin-block-end: var(--space-6);
    }

    .index {
      color: var(--signal-text);
    }

    .note {
      color: var(--text-secondary);
      max-inline-size: 44ch;
    }

    @media (min-width: 64rem) {
      .section-heading {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--grid-gutter);
        align-items: baseline;
      }

      .index {
        grid-column: 1 / span 2;
      }

      h2 {
        grid-column: 3 / span 6;
      }

      .note {
        grid-column: 9 / -1;
      }
    }
  }
</style>
